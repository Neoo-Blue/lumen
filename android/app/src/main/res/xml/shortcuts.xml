<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="talk" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_talk">
        <intent android:action="android.intent.action.VOICE_COMMAND"
            android:targetPackage="ai.lumen.assistant" android:targetClass="ai.lumen.assistant.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="scan" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_scan">
        <intent android:action="android.intent.action.VIEW" android:data="ai.lumen.assistant://ask?q=Take%20a%20picture%20and%20tell%20me%20what%20it%20is"
            android:targetPackage="ai.lumen.assistant" android:targetClass="ai.lumen.assistant.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="day" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_day">
        <intent android:action="android.intent.action.VIEW" android:data="ai.lumen.assistant://ask?q=What%20does%20my%20day%20look%20like%3F"
            android:targetPackage="ai.lumen.assistant" android:targetClass="ai.lumen.assistant.MainActivity" />
    </shortcut>
</shortcuts>
