# Everything here can also be set in the setup dashboard (http://<this machine>:8080/setup). Leave blank to use the dashboard.

# The name of this server on your Tailscale network: https://<name>.<your-tailnet>.ts.net
LUMEN_HOSTNAME=lumen

# Optional: a Tailscale auth key, so the server joins your network without the sign-in link.
# Make one at https://login.tailscale.com/admin/settings/keys (not reusable, not ephemeral).
TS_AUTHKEY=

# Optional: your assistant's name.
LUMEN_NAME=

# Optional: the AI model. Provider is one of: anthropic, openai, gemini, ollama, custom
LUMEN_PROVIDER=
LUMEN_API_KEY=
LUMEN_MODEL=
# Only for ollama or custom: the address of the model service, e.g. http://192.168.1.20:11434/v1
LUMEN_BASE_URL=

# Optional: a voice key for talking out loud.
CARTESIA_API_KEY=
